APP_NAME=SkillScout API
ENV=development

# SQLite by default (zero-config). Swap for a Neon connection string to go to Postgres, e.g.:
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/skillscout?sslmode=require
DATABASE_URL=sqlite:///./skillscout.db

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GitHub personal access token (public_repo scope). Raises rate limit from 60/hr to 5000/hr.
GITHUB_TOKEN=

# sentence-transformers + torch need more RAM than free-tier hosts usually
# give a web service. Set to false there to avoid OOM crashes -- falls back
# to a lighter TF-IDF matcher automatically.
USE_EMBEDDING_MODEL=true

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
